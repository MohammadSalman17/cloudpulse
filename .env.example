# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_API_KEY=your_confluent_api_key
KAFKA_API_SECRET=your_confluent_api_secret
KAFKA_TOPIC=cloudpulse-events
KAFKA_GROUP_ID=cloudpulse-consumer-group
KAFKA_USE_SSL=true

# Google AI Studio / Gemini Key
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_AI_MODEL=gemini-2.5-flash

# Groq API Key (for Autonomous Anomaly Remediation Agent)
GROQ_API_KEY=
